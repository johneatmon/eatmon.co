# Scope-only registry mapping (safe to commit).
# Auth token must NOT live here — pnpm no longer expands ${ENV} in project .npmrc.
# Local/CI: set GITHUB_PAT, then either:
#   pnpm config set "//npm.pkg.github.com/:_authToken" "$GITHUB_PAT"
# or rely on installCommand / scripts/setup-github-packages-auth.ts
@johneatmon:registry=https://npm.pkg.github.com
